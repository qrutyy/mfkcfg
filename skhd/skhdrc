# Модификаторы: alt = ⌥ Option, ctrl = ⌃ Control, cmd = ⌘, shift = ⇧
# Cmd+hjkl/d/t/w/s/1-5 в Ghostty уходят в tmux (как Alt), физически Option там не нажимается,
# поэтому Option свободен для yabai: Cmd+hjkl = панели tmux, Option+hjkl = окна yabai.

# --- Фокус (⌥ + hjkl) ---
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# циклический фокус по всем окнам спейса
alt - tab : yabai -m window --focus next || yabai -m window --focus first
alt + shift - tab : yabai -m window --focus prev || yabai -m window --focus last

# --- Перемещение окна по дереву (⌥⇧ + hjkl) ---
alt + shift - h : yabai -m window --warp west
alt + shift - j : yabai -m window --warp south
alt + shift - k : yabai -m window --warp north
alt + shift - l : yabai -m window --warp east

# --- Swap с соседом (⌃⌥ + hjkl) ---
ctrl + alt - h : yabai -m window --swap west
ctrl + alt - j : yabai -m window --swap south
ctrl + alt - k : yabai -m window --swap north
ctrl + alt - l : yabai -m window --swap east

# --- Ресайз (⌃⌥ + стрелки; ⌥+стрелки оставлены шеллу для прыжков по словам) ---
ctrl + alt - left  : yabai -m window --resize left:-60:0  || yabai -m window --resize right:-60:0
ctrl + alt - right : yabai -m window --resize right:60:0  || yabai -m window --resize left:60:0
ctrl + alt - up    : yabai -m window --resize top:0:-60   || yabai -m window --resize bottom:0:-60
ctrl + alt - down  : yabai -m window --resize bottom:0:60 || yabai -m window --resize top:0:60

# --- Создать / закрыть ---
# новое окно Ghostty (новый тайл)
alt - return : open -na Ghostty
# закрыть окно в фокусе
alt + shift - w : yabai -m window --close

# --- Раскладка ---
alt - 0 : yabai -m space --balance                            # выровнять размеры
alt - r : yabai -m space --rotate 90                          # повернуть дерево
alt - e : yabai -m window --toggle split                      # сменить направление сплита
alt - f : yabai -m window --toggle float --grid 6:6:1:1:4:4   # float по центру
alt - z : yabai -m window --toggle zoom-fullscreen            # окно на весь экран (внутри спейса)
ctrl + alt - space : yabai -m space --layout $(yabai -m query --spaces --space | jq -r 'if .type == "bsp" then "stack" else "bsp" end')

# --- Мониторы ---
alt - m : yabai -m display --focus next || yabai -m display --focus first
alt + shift - m : yabai -m window --display next; yabai -m display --focus next

# --- Сервис ---
ctrl + alt - q : yabai --restart-service
ctrl + alt + shift - q : skhd --reload
